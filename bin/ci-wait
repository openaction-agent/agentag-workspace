#!/usr/bin/env bash
# Wait for the CI of one commit, polling quietly and printing a line only when the summary changes.
#
# Usage: bin/ci-wait [--host <forgejo-host>] <owner/repo> <sha> [--interval <seconds>] [--max-wait <seconds>]
#
# Without --host, the commit is on GitHub and read with `gh`. With --host (for example git.openaction.eu), the
# commit is on that Forgejo instance and read with `fj`.
#
# Exit codes:
#   0  every check completed successfully (skipped and neutral count as success)
#   1  at least one check failed (fails fast; failed checks are listed with their job or run)
#   2  checks are still pending after --max-wait: run the command again
#   3  no check appeared for this commit within the grace period
#   4  usage or API error

set -uo pipefail

usage() {
  echo "Usage: $0 [--host <forgejo-host>] <owner/repo> <sha> [--interval <seconds>] [--max-wait <seconds>]" >&2
  exit 4
}

host="" interval=30 max_wait=540 grace=180
args=()
while [ $# -gt 0 ]; do
  case $1 in
    --host) host=${2:?}; shift 2 ;;
    --interval) interval=${2:?}; shift 2 ;;
    --max-wait) max_wait=${2:?}; shift 2 ;;
    -*) usage ;;
    *) args+=("$1"); shift ;;
  esac
done
[ ${#args[@]} -eq 2 ] || usage
repo=${args[0]} sha=${args[1]}

# Each fetcher prints one TSV line per check: name, state (pending|success|failure), reference to inspect it.

fetch_github() {
  local runs statuses
  runs=$(gh api --paginate "repos/$repo/commits/$sha/check-runs?per_page=100" --jq '.check_runs[] | [
      .name,
      (if .status != "completed" then "pending"
       elif (.conclusion | IN("success", "skipped", "neutral")) then "success"
       else "failure" end),
      "job \(.id)"
    ] | @tsv' 2>&1) || { echo "GitHub API error (check runs): $runs" >&2; return 1; }
  statuses=$(gh api "repos/$repo/commits/$sha/status" --jq '.statuses[] | [
      .context,
      (if .state == "pending" then "pending" elif .state == "success" then "success" else "failure" end),
      "status \(.target_url // "")"
    ] | @tsv' 2>&1) || { echo "GitHub API error (statuses): $statuses" >&2; return 1; }
  printf '%s\n%s\n' "$runs" "$statuses"
}

# `fj actions tasks` lists tasks newest first, 20 per page, as
# `#<run> (<short sha>) <status> <job> <duration> (<event>): <title>`.
# Only the latest attempt of each job and event is kept.
fetch_forgejo() {
  local page=1 out tasks matches seen=0
  while [ $page -le 10 ]; do
    out=$(fj -H "$host" --style minimal actions tasks -r "$repo" -p $page 2>&1) \
      || { echo "Forgejo error (fj actions tasks): $out" >&2; return 1; }
    # job, status, short sha, run, event
    tasks=$(printf '%s\n' "$out" | LC_ALL=C perl -ne 'print "$4\t$3\t$2\t$1\t$5\n" if /^#(\d+) \(([0-9a-f]+)\) (\S+) (.+?) \S+ \(([^)]*)\): /')
    [ -n "$tasks" ] || break
    matches=$(printf '%s\n' "$tasks" | awk -F'\t' -v sha="$sha" 'length($3) >= 7 && index(sha, $3) == 1')
    if [ -n "$matches" ]; then
      seen=1
      printf '%s\n' "$matches"
      # Tasks of one push are contiguous: stop once this page also lists older commits after them.
      [ "$(printf '%s\n' "$tasks" | tail -n 1 | cut -f3)" = "$(printf '%s\n' "$matches" | tail -n 1 | cut -f3)" ] || break
    elif [ $seen -eq 1 ]; then
      break
    fi
    page=$((page + 1))
  done | awk -F'\t' -v OFS='\t' -v base="https://$host/$repo/actions/runs/" '
    !seen[$1 "\t" $5]++ {
      state = ($2 ~ /^(success|skipped)$/) ? "success" : ($2 ~ /^(failure|cancelled)$/) ? "failure" : "pending"
      print $1 " (" $5 ")", state, "run " base $4
    }'
}

start=$(date +%s)
last=""

while :; do
  if [ -n "$host" ]; then all=$(fetch_forgejo) || exit 4; else all=$(fetch_github) || exit 4; fi
  all=$(printf '%s\n' "$all" | sed '/^$/d')
  total=$(printf '%s' "$all" | grep -c . || true)
  pending=$(printf '%s\n' "$all" | awk -F'\t' '$2=="pending"' | grep -c . || true)
  failed=$(printf '%s\n' "$all" | awk -F'\t' '$2=="failure"' | grep -c . || true)
  passed=$((total - pending - failed))
  elapsed=$(( $(date +%s) - start ))

  summary="total=$total passed=$passed pending=$pending failed=$failed"
  if [ "$summary" != "$last" ]; then
    echo "[$(date +%H:%M:%S) +${elapsed}s] $summary"
    last=$summary
  fi

  if [ "$failed" -gt 0 ]; then
    echo "CI FAILED for $sha:"
    printf '%s\n' "$all" | awk -F'\t' '$2=="failure" { print "- " $1 " (" $3 ")" }'
    [ "$pending" -gt 0 ] && echo "($pending still pending)"
    exit 1
  fi
  if [ "$total" -gt 0 ] && [ "$pending" -eq 0 ]; then
    echo "CI PASSED for $sha ($passed checks)"
    exit 0
  fi
  if [ "$total" -eq 0 ] && [ "$elapsed" -ge "$grace" ]; then
    echo "NO CI found for $sha after ${elapsed}s: check the workflow triggers, branch, and SHA."
    exit 3
  fi
  if [ "$elapsed" -ge "$max_wait" ]; then
    echo "CI STILL PENDING for $sha after ${elapsed}s: run the command again."
    exit 2
  fi
  sleep "$interval"
done
